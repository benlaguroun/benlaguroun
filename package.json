{
  "name": "brand-platform",
  "private": true,
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run generate -w @brand/db",
    "db:push": "npm run push -w @brand/db",
    "db:migrate": "npm run migrate -w @brand/db",
    "db:seed": "npm run seed -w @brand/db",
    "db:services": "npm run services -w @brand/db",
    "db:results": "npm run results -w @brand/db",
    "db:catalog": "npm run catalog -w @brand/db",
    "db:admin": "npm run admin -w @brand/db --"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "^5.9.0"
  }
}
