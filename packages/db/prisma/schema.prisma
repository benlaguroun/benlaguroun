generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (better-auth core tables) + a role column for admin access
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions     Session[]
  accounts     Account[]
  orders       Order[]
  entitlements Entitlement[]
  progress     LessonProgress[]
  client       Client?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Catalog: services, templates and courses all live in one Product table
// ---------------------------------------------------------------------------

enum ProductType {
  SERVICE
  TEMPLATE
  COURSE
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  type        ProductType
  name        String
  tagline     String
  description String
  priceCents  Int?        // null on a service means "custom quote"
  currency    String      @default("usd")
  imageUrl    String?
  features    String[]
  translations Json?       // { fr: {name, tagline, description, features}, ar: {...} }
  deliveryUrl String?     // templates: download link handed over after purchase (used when there is no uploaded file)
  deliveryFile String?    // templates: file uploaded to the server's private folder (preferred over deliveryUrl)
  deliveryName String?    // templates: the original file name buyers see when they download it
  previewUrl  String?     // templates: live demo
  published   Boolean     @default(true)
  featured    Boolean     @default(false)
  position    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Optional per-provider IDs. If empty, checkout creates the price inline.
  stripePriceId   String?
  lemonVariantId  String?  // no longer used (Lemon Squeezy is shutting down); safe to drop later

  course       Course?
  orders       Order[]
  entitlements Entitlement[]

  @@index([type, published])
}

model Course {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  modules   Module[]
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  translations Json?
  position Int
  lessons  Lesson[]

  @@index([courseId, position])
}

model Lesson {
  id          String           @id @default(cuid())
  moduleId    String
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  summary     String?
  content     String           // plain text / markdown-ish body
  videoUrl    String?          // embed URL (YouTube, Vimeo, Bunny, Mux...)
  durationMin Int?
  translations Json?
  isPreview   Boolean          @default(false) // free to watch without buying
  position    Int
  progress    LessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId, position])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  amountCents Int
  currency    String
  provider    String      // "stripe" | "paypal"
  providerRef String?     @unique // checkout session / order id from the provider
  status      OrderStatus @default(PENDING)
  locale      String      @default("en") // language the buyer used, for their receipt
  createdAt   DateTime    @default(now())
  paidAt      DateTime?
  receiptSentAt DateTime? // set once the receipt email has gone out

  entitlement Entitlement?

  @@index([userId])
}

// An entitlement = "this user owns this product". Courses and template
// downloads are gated on it.
model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String?  @unique
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------------------------------------------------------------------------
// Portfolio + inbound leads
// ---------------------------------------------------------------------------

model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  client    String?
  summary   String
  body      String
  tags      String[]
  imageUrl  String?   // cover image
  images    String[]  // more screenshots, shown as a gallery
  liveUrl   String?
  translations Json?
  featured  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

enum LeadStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

// A message sent through the contact form.
model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  interest  String?    // service slug or free text
  budget    String?
  message   String
  status    LeadStatus @default(NEW)
  clientId  String?
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  agentTasks AgentTask[]

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Admin: clients and payments you record yourself
// ---------------------------------------------------------------------------

enum ClientStatus {
  PROSPECT
  ACTIVE
  PAST
}

model Client {
  id        String       @id @default(cuid())
  name      String
  email     String?      @unique
  phone     String?
  company   String?
  status    ClientStatus @default(PROSPECT)
  source    String?      // e.g. "Contact form", "Referral"
  notes     String?
  userId    String?      @unique // linked website account, if they have one
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  leads    Lead[]
  payments Payment[]

  @@index([status])
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  ONLINE
  OTHER
}

// Money you collect outside the store (service work, invoices, deposits).
// Store sales live in Order and are shown next to these in the admin.
model Payment {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  amountCents Int
  currency    String        @default("usd")
  method      PaymentMethod @default(BANK_TRANSFER)
  status      PaymentStatus @default(PENDING)
  description String
  reference   String?       // invoice number, transfer reference...
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Social proof and audience
// ---------------------------------------------------------------------------

// A real client quote shown on the home page once it is published.
model Testimonial {
  id           String   @id @default(cuid())
  name         String
  role         String?  // e.g. "Director, Al Noor School"
  quote        String
  translations Json?    // { fr: {role, quote}, ar: {...} }
  published    Boolean  @default(false)
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([published, position])
}

// Someone who asked to hear from you by email.
model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("en")
  source         String?   // where they signed up, e.g. "footer"
  token          String    @unique @default(cuid()) // used in the unsubscribe link
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([active, createdAt])
}

// ---------------------------------------------------------------------------
// Blog
// ---------------------------------------------------------------------------

// body is written in a small subset of Markdown (headings, lists, bold, links,
// code, quotes, images); see lib/markdown.tsx.
model Post {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String
  body         String
  coverUrl     String?
  tags         String[]
  translations Json?     // { fr: {title, excerpt, body}, ar: {...} }
  published    Boolean   @default(false)
  publishedAt  DateTime? // set the first time the post is published
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([published, publishedAt])
}

// ---------------------------------------------------------------------------
// First-party analytics: no cookies, no IP addresses stored
// ---------------------------------------------------------------------------

model PageView {
  id        String   @id @default(cuid())
  path      String   // without the language, e.g. "/services/launch-site"
  locale    String
  referrer  String?  // the site they came from (host only)
  country   String?  // two-letter code, when the host provides it (Cloudflare does)
  device    String   // mobile | tablet | desktop
  visitor   String   // a hash that changes every day, so nobody can be followed across days
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
}

// ---------------------------------------------------------------------------
// Error alerts: the same problem is stored once, with a counter
// ---------------------------------------------------------------------------

model ErrorLog {
  id          String    @id @default(cuid())
  fingerprint String    @unique // groups repeats of the same error
  source      String    // server | payment | webhook | email
  message     String
  stack       String?
  path        String?   // the request that failed, e.g. "POST /api/checkout"
  count       Int       @default(1)
  firstSeen   DateTime  @default(now())
  lastSeen    DateTime  @default(now())
  resolved    Boolean   @default(false)
  notifiedAt  DateTime? // when you were last emailed about it

  @@index([resolved, lastSeen])
}

// Items on the Admin -> Roadmap page that you tick off by hand. Items the site can
// check by itself (email set, products published, ...) are not stored here.
model RoadmapItem {
  key       String   @id // matches a key in apps/web/src/lib/roadmap.ts
  done      Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Ben, the AI assistant. Every time it reads a message it writes one AgentTask: what it
// understood, how sure it is, and the reply it drafted. Nothing is sent until you approve.
enum AgentTaskStatus {
  PENDING   // waiting for your decision
  SENT      // you approved and the reply was emailed
  REJECTED  // you decided not to send it
  HANDLED   // nothing to send (spam), or you answered it yourself
  FAILED    // the assistant could not produce a draft
}

model AgentTask {
  id          String          @id @default(cuid())
  kind        String          // "inbound" (new message), "draft" (you asked), "order" (you gave an instruction)
  status      AgentTaskStatus @default(PENDING)
  leadId      String?
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  instruction String?         // your order, when kind is "order"
  category    String?         // sales_lead | support | refund | partnership | spam | other
  urgency     String?         // low | normal | high
  language    String?         // en | fr | ar
  summary     String?
  confidence  Int?            // 0-100, how sure the assistant is
  needsYou    String?         // why a person has to decide, when it says so
  subject     String?
  draft       String?         // the reply it proposes
  finalText   String?         // what was actually sent (your edited version)
  provider    String?         // anthropic | openai | groq: who actually wrote the draft
  model       String?
  tokensIn    Int             @default(0)
  tokensOut   Int             @default(0)
  error       String?
  createdAt   DateTime        @default(now())
  decidedAt   DateTime?

  @@index([status, createdAt])
  @@index([leadId])
}

// One row (id "main"): the on/off switch and the rules Ben works by.
model AgentConfig {
  id           String   @id @default("main")
  enabled      Boolean  @default(false) // master switch: when off, Ben does nothing at all
  provider     String   @default("anthropic") // main AI service: anthropic (Claude) | openai | groq
  fallback     Boolean  @default(true)        // if the main one fails, try the others that have a key
  dailyLimit   Int      @default(30)    // most drafts per day, so a flood of messages cannot run up a bill
  signature    String   @default("Ben's assistant (AI), reviewed by Ben")
  instructions String   @default("")    // your own rules: tone, availability, what to offer, what never to promise
  updatedAt    DateTime @updatedAt
}
