# Copy to apps/web/.env.local and packages/db/.env (or export in your shell)

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brand_platform"

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # in production: your real domain, e.g. https://benlaguroun.com (used by sitemap, canonical links and share images)
# Optional: code from Google Search Console (HTML tag method) to verify the site
# GOOGLE_SITE_VERIFICATION=""

# --- Payments ---
# A method appears at checkout as soon as its keys are filled in.
# Optional: limit the methods offered, e.g. PAYMENT_PROVIDERS="stripe,paypal"

# Stripe (card payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal. Use "sandbox" while testing, "live" for real money.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# Lemon Squeezy (optional third method)
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# --- Email (optional): receipts for buyers, and a note to you for every sale and contact message ---
# Create a free account at brevo.com, verify a sender address, then create an API key.
BREVO_API_KEY=""
EMAIL_FROM=""            # a sender you verified in Brevo, e.g. hello@yourdomain.com
EMAIL_FROM_NAME="Ben Laguroun"
ADMIN_NOTIFY_EMAIL=""    # where YOU get notifications (defaults to the email in site.ts)
