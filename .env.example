# Copy to apps/web/.env.local and packages/db/.env (or export in your shell)

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brand_platform"

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # in production: your real domain, e.g. https://benlaguroun.com (used by sitemap, canonical links and share images)
# Optional: code from Google Search Console (HTML tag method) to verify the site
# GOOGLE_SITE_VERIFICATION=""

# --- Payments ---
# A method appears at checkout as soon as its keys are filled in.
# Optional: limit the methods offered, e.g. PAYMENT_PROVIDERS="stripe,paypal"

# Stripe (card payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal. Use "sandbox" while testing, "live" for real money.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""


# --- Email (optional): receipts for buyers, and a note to you for every sale and contact message ---
# Create a free account at brevo.com, verify a sender address, then create an API key.
BREVO_API_KEY=""
EMAIL_FROM=""            # a sender you verified in Brevo, e.g. hello@yourdomain.com
EMAIL_FROM_NAME="Ben Laguroun"
ADMIN_NOTIFY_EMAIL=""    # where YOU get notifications (defaults to the email in site.ts)

# Where images you upload in the admin are stored, plus the private "private" folder
# inside it that holds template files (ZIP/PDF) buyers download. Defaults to
# apps/web/uploads. Put it on a disk that is backed up.
# Download links in receipt emails are signed with BETTER_AUTH_SECRET, so keep that
# long and random in production.
UPLOAD_DIR=""

# Ben, the AI assistant (Admin -> Assistant). It drafts replies to contact messages; you approve every one.
# Add the key for each AI service you want to use. Pick the main one in Assistant -> Settings;
# if it fails, Ben tries the others that have a key.
ANTHROPIC_API_KEY=""      # Claude, from console.anthropic.com
OPENAI_API_KEY=""         # OpenAI, from platform.openai.com
GROQ_API_KEY=""           # Groq, from console.groq.com
# Optional model names (sensible defaults are built in):
AGENT_MODEL=""            # Claude, default claude-sonnet-5-5
OPENAI_MODEL=""           # default gpt-5.4-mini
GROQ_MODEL=""             # default openai/gpt-oss-120b
